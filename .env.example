# Copy this file to backend/.env. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./govconnect.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durable private evidence storage (required before production uploads are enabled)
# Use a private S3-compatible bucket (for example AWS S3 or Cloudflare R2).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional provider-supported value such as AES256 or aws:kms. Leave blank if the provider
# handles encryption at rest automatically (confirm this in the bucket provider settings).
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=

# ClamAV malware scanner (required before production evidence uploads are enabled)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# SMTP notification delivery (optional; notification emails are skipped until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Optional SMS delivery through Termii (Nigeria). SMS remains disabled until
# credentials are configured, a user verifies their number, and the user opts in.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_API_URL=https://api.ng.termii.com/api/sms/send
SMS_TIMEOUT_SECONDS=10

# Durable notification outbox worker (run as a separate Render Background Worker)
NOTIFICATION_WORKER_POLL_SECONDS=15
NOTIFICATION_WORKER_BATCH_SIZE=25

# Privacy retention: phone verification challenges are purged after 24 hours.
# Delivery history is retained indefinitely unless a reviewed policy sets a positive number of days.
NOTIFICATION_DELIVERY_RETENTION_DAYS=0
